+static void sdl2_enable_per_monitor_dpi_awareness(void)
+{
+    typedef BOOL (WINAPI *SetProcessDpiAwarenessContextFn)(HANDLE);
+    HMODULE user32 = GetModuleHandle("user32.dll");
+    SetProcessDpiAwarenessContextFn set_process_dpi_awareness_context;
+
+    if (!user32) {
+        return;
+    }
+    set_process_dpi_awareness_context =
+        (SetProcessDpiAwarenessContextFn)GetProcAddress(
+            user32, "SetProcessDpiAwarenessContext");
+    if (set_process_dpi_awareness_context) {
+        set_process_dpi_awareness_context((HANDLE)(intptr_t)-4);
+    }
+}
+#endif
