+static void sdl2_borderless_maximize(SDL_Window *window)
+{
+    SDL_Rect bounds;
+    int display = SDL_GetWindowDisplayIndex(window);
+
+    if (display < 0) {
+        display = 0;
+    }
+
+    if (SDL_GetDisplayUsableBounds(display, &bounds) == 0) {
+        SDL_SetWindowPosition(window, bounds.x, bounds.y);
+        SDL_SetWindowSize(window, bounds.w, bounds.h - 1);
+    }
+}
+
+static void sdl2_window_decorate(SDL_Window *window)
+{
+    SDL_Rect bounds;
+    int top, left, bottom, right;
+    int display = SDL_GetWindowDisplayIndex(window);
+
+    if (display < 0) {
+        display = 0;
+    }
+
+    SDL_SetWindowBordered(window, SDL_TRUE);
+    if (SDL_GetDisplayUsableBounds(display, &bounds) == 0 &&
+        SDL_GetWindowBordersSize(window, &top, &left, &bottom, &right) == 0) {
+        SDL_SetWindowPosition(window, bounds.x + left, bounds.y + top);
+        SDL_SetWindowSize(window, bounds.w - left - right,
+                          bounds.h - top - bottom);
+    }
+}
